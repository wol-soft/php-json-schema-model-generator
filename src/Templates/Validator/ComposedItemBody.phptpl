{% if generatorConfiguration.collectErrors() %}
    // collect errors for each composition element
    $this->_errorRegistry = new {{ viewHelper.getSimpleClassName(generatorConfiguration.getErrorRegistryClass()) }}();
{% endif %}

{% if not postPropose %}
    $proposedValue = $proposedValue ?? $value;
{% endif %}

{{ viewHelper.resolvePropertyDecorator(compositionProperty, false, 0) }}

{% foreach compositionProperty.getOrderedValidators() as validator %}
    {{ viewHelper.renderValidator(validator, schema, 0) }}
{% endforeach %}

{% if generatorConfiguration.collectErrors() %}
    $compositionErrorCollection[] = $this->_errorRegistry;

    {% if isMutableBaseValidator %}
        if (isset($validatorIndex)) {
            $this->_propertyValidationState[$validatorIndex][$validatorComponentIndex] = $this->_errorRegistry;
        }
    {% endif %}

    // an error inside the composed validation occurred. Throw an exception to count the validity of the
    // composition item
    if ($this->_errorRegistry->getErrors()) {
        throw new \Exception();
    }
{% endif %}

{% if not generatorConfiguration.collectErrors() %}
    {#
        Mirror the collect-errors path: every branch - not just failing ones - must contribute an
        entry to $compositionErrorCollection so InvalidComposedValueException::getErrorMessage()
        numbers elements by their real schema position instead of by position among failures. A
        branch reaching this point ran to completion without throwing, so it is valid; an empty
        ErrorRegistryException renders as "Valid". The failing counterpart is appended in the
        catch block in ComposedItem.phptpl. A branch of a mutable base validator which is answered
        from the validation state instead of being evaluated skips this body: ComposedItem.phptpl
        appends its entry where the state is read.
    #}
    $compositionErrorCollection[] = new \PHPModelGenerator\Exception\ErrorRegistryException();
{% endif %}

{% if postPropose %}
    $proposedValue = $proposedValue ?? $value;
{% endif %}

{% if hasModifiedValuesMethod %}
    if (is_object($value)) {
        $componentModifiedValues = $this->{{ modifiedValuesMethod }}($originalModelData, $value, $validatorComponentIndex);
        $modifiedValues = array_merge($modifiedValues, $componentModifiedValues);
        {% if filterSourceMap %}

            // Hand over which filter produced the values (see getFilterSourceMap()).
            foreach ({{ filterSourceMap }}[$validatorComponentIndex] ?? [] as $sourceKey => $source) {
                if (array_key_exists($sourceKey, $componentModifiedValues)) {
                    $publishedSources[$sourceKey] = $source === true
                        ? (function () use ($sourceKey) {
                            return $this->_branchFilteredSources[$sourceKey] ?? null;
                        })->call($value)
                        : $source;
                }
            }
        {% endif %}
    }
{% endif %}
{% if isMutableBaseValidator %}
    {% if not generatorConfiguration.collectErrors() %}
        if (isset($validatorIndex)) {
            $this->_propertyValidationState[$validatorIndex][$validatorComponentIndex] = true;
        }
    {% endif %}
{% endif %}
