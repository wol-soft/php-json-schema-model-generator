is_array($value) && (static function (array $items): bool {
    $seenItems = [];

    foreach (\PHPModelGenerator\Utils\JsonValue::normalize($items) as $item) {
        // wrapped to compare the item as an element of a structure: 1 and 1.0 are the same item of an array
        if (\PHPModelGenerator\Utils\JsonValue::contains($seenItems, [$item])) {
            return true;
        }

        $seenItems[] = [$item];
    }

    return false;
})($value)
