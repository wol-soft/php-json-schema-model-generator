(function (&$value): bool {
    // the staged values belong to the update which is in progress. A staged null: the branch
    // which owns the filter is inactive, the value stays as provided
    if (array_key_exists('{{ escapedPropertyName }}', $this->_stagedBranchFilteredValues)) {
        if ($this->_stagedBranchFilteredValues['{{ escapedPropertyName }}'] !== null) {
            $value = $this->_stagedBranchFilteredValues['{{ escapedPropertyName }}'][0];
        }
    } elseif (array_key_exists('{{ escapedPropertyName }}', $this->_branchFilteredValues)) {
        $value = $this->_branchFilteredValues['{{ escapedPropertyName }}'];
    }

    return false;
})($value)
