{% if onlyForDefinedValues %}
    $value !== null &&
{% endif %}
{% if providedPropertyCheck %}
    {{ providedPropertyCheck }} &&
{% endif %}
{% if typeGuard %}
    {{ typeGuard }} &&
{% endif %}
(function (&$value) use (
    &$modelData,
    &$modifiedModelData,
    &$compositionErrorCollection,
    &$succeededCompositionElements,
    &$validatorIndex{% if publishesFilteredValues %},
    &$publishedValues,
    &$evaluatedComponents{% endif %}{% if filterSourceMap %},
    &$publishedSources{% endif %}
) {
    $succeededCompositionElements = {{ availableAmount }};
    $validatorComponentIndex = 0;
    $originalModelData = $value;
    $proposedValue = null;
    $modifiedValues = [];

    {% if compositionValidator.hasItemFilteringBranches() %}
        $branchItemValues = [];
    {% endif %}

    {% if compositionValidator.getSlotKey() %}
        $slotKey = '{{ viewHelper.escapeSingleQuoted(compositionValidator.getSlotKey()) }}';
        $compositionEvaluatedIndices = [];
    {% endif %}

    {% if generatorConfiguration.collectErrors() %}
        $originalErrorRegistry = $this->_errorRegistry;
    {% endif %}

    {% if compositionValidator.tracksEvaluatedItems() %}
        {#
            The branches which read or record evaluated indices are validated in an evaluation scope of their own:
            each one starts without any evaluated index and leaves the indices of the enclosing arrays as it found
            them. The indices recorded by a branch which succeeds are collected and handed to the enclosing array
            (the serialization of a filtered unevaluatedItems reads them), also if the composition as a whole fails:
            the spec drops the annotations of a schema object which fails, the branch which succeeded keeps them for
            the keywords next to the composition. The schema object holding a failed composition fails itself: if it
            is a branch of an enclosing composition, the scope of that branch discards the indices. Handing the
            indices over only for a composition which succeeds was rejected: with collected errors the
            unevaluatedItems next to a failed allOf reported the items its passing branch evaluated. A not never
            hands indices over.
        #}
        $evaluatedItemIndicesBeforeComposition = $this->_evaluatedItemIndices;
        $evaluatedItemIndicesOfSucceededBranches = [];
    {% endif %}

    {% foreach compositionProperties as compositionProperty %}
        {% if compositionValidator.isNotComposition() and compositionValidator.hasEvaluationTrackingEnabled() and not compositionValidator.getSlotKey() %}
            $preNotBranchEvaluations = $this->_compositionEvaluations ?? [];
        {% endif %}

        {% if compositionValidator.hasEvaluationTrackingEnabled() %}
            $shouldTrack = true;
        {% endif %}

        {% if compositionProperty.tracksEvaluatedItems() %}
            $this->_evaluatedItemIndices = [];
        {% endif %}

        try {
            {% if viewHelper.isMutableBaseValidator(generatorConfiguration, isBaseValidator) %}
                {% if compositionProperty.dependsOnUndeclaredValues() %}
                    {#
                        The branch depends on the values of keys it doesn't declare (e.g. patternProperties): whether
                        the cached result is still valid can't be decided by the updated properties, always evaluate
                        the branch again.
                    #}
                    {% if compositionValidator.getSlotKey() and compositionProperty.branchHasContains() %}
                        $branchContainsMatches = [];
                    {% endif %}
                    {% if publishesFilteredValues %}
                        $evaluatedComponents[] = $validatorComponentIndex;
                    {% endif %}
                    {{ viewHelper.indent(renderComposedItemBody(compositionProperty, true, hasModifiedValuesMethod, modifiedValuesMethod, postPropose, filterSourceMap), 2) }}
                {% else %}
                    // check if the state of the validator is already known.
                    // If none of the properties affected by the validator are changed the validator must not be re-evaluated
                    {#
                        A branch depending on the keys only (e.g. maxProperties) is evaluated again if an update adds
                        a key: the updated data isn't stored yet.
                    #}
                    if (
                        isset($validatorIndex) &&
                        isset($this->_propertyValidationState[$validatorIndex][$validatorComponentIndex]) &&
                        !array_intersect(
                            array_keys($modifiedModelData),
                            [
                                {% foreach compositionProperty.getAffectedObjectProperties() as affectedObjectProperty %}
                                    '{{ viewHelper.escapeSingleQuoted(affectedObjectProperty.getName()) }}',
                                {% endforeach %}
                            ]
                        ){% if compositionProperty.dependsOnAddedKeys() %} &&
                        !array_diff_key($modifiedModelData, $this->_rawModelDataInput){% endif %}
                    ) {
                        {% if compositionValidator.hasEvaluationTrackingEnabled() %}
                            // Cache hit: validators are not re-run, so $value still holds the
                            // pre-validator array rather than a nested-schema object. Skip the
                            // tracking write to preserve the slot value from the previous run.
                            $shouldTrack = false;
                        {% endif %}

                        {% if generatorConfiguration.collectErrors() %}
                            $compositionErrorCollection[] = $this->_propertyValidationState[$validatorIndex][$validatorComponentIndex];
                        {% endif %}

                        if ({% if generatorConfiguration.collectErrors() %}
                                $this->_propertyValidationState[$validatorIndex][$validatorComponentIndex]->getErrors()
                            {% else %}
                                $this->_propertyValidationState[$validatorIndex][$validatorComponentIndex] !== true
                            {% endif %}
                        ) {
                            throw new \Exception();
                        }
                    } else {
                        {% if compositionValidator.getSlotKey() and compositionProperty.branchHasContains() %}
                            $branchContainsMatches = [];
                        {% endif %}
                        {% if publishesFilteredValues %}
                            $evaluatedComponents[] = $validatorComponentIndex;
                        {% endif %}
                        {{ viewHelper.indent(renderComposedItemBody(compositionProperty, true, hasModifiedValuesMethod, modifiedValuesMethod, postPropose, filterSourceMap), 3) }}
                    }
                {% endif %}
            {% else %}
                {% if compositionValidator.getSlotKey() and compositionProperty.branchHasContains() %}
                    $branchContainsMatches = [];
                {% endif %}
                {% if publishesFilteredValues %}
                    $evaluatedComponents[] = $validatorComponentIndex;
                {% endif %}
                {{ viewHelper.indent(renderComposedItemBody(compositionProperty, false, hasModifiedValuesMethod, modifiedValuesMethod, postPropose, filterSourceMap), 2) }}
            {% endif %}

            {% if compositionValidator.hasItemFilteringBranches() and compositionProperty.filtersArrayItems() %}
                // The branch succeeded and its filters transformed the items. The reset after the branch gives the
                // next branch the items as provided, the result of the branch is adopted after all branches ran.
                $branchItemValues[$validatorComponentIndex] = $value;
            {% endif %}

            {% if compositionValidator.hasEvaluationTrackingEnabled() and compositionValidator.getSlotKey() and compositionProperty.needsEvaluatedIndexAggregation() %}
                {# A value which is no array (the property may hold a string as well) has no items to credit #}
                if ($shouldTrack && is_array($originalModelData)) {
                    {% if compositionProperty.branchClaimsAllIndices() %}
                        $compositionEvaluatedIndices += array_fill_keys(array_keys($originalModelData), true);
                    {% endif %}
                    {% if not compositionProperty.branchClaimsAllIndices() and compositionProperty.getBranchTupleItemsCount() %}
                        $compositionEvaluatedIndices += array_fill(
                            0,
                            min({{ compositionProperty.getBranchTupleItemsCount() }}, count($originalModelData)),
                            true,
                        );
                    {% endif %}
                    {% if compositionProperty.branchHasContains() %}
                        $compositionEvaluatedIndices += $branchContainsMatches;
                    {% endif %}
                    {% foreach compositionProperty.getNestedCompositionSlotKeys() as nestedCompositionSlotKey %}
                        // A composition nested directly inside this branch's own JSON (no
                        // intervening object type, so no nested Schema of its own) tracked its
                        // claimed indices under its own slot — union them into this branch's set.
                        $compositionEvaluatedIndices += $this->_compositionAnnotated['{{ viewHelper.escapeSingleQuoted(nestedCompositionSlotKey) }}'] ?? [];
                    {% endforeach %}
                    {% if compositionProperty.getEvaluatedItemsKey() %}
                        // The indices evaluated by the contains of this branch and by its own unevaluatedItems
                        $compositionEvaluatedIndices += $this->_evaluatedItemIndices[{{ compositionProperty.getEvaluatedItemsKey() }}] ?? [];
                    {% endif %}
                }
            {% endif %}
            {% if compositionValidator.hasEvaluationTrackingEnabled() and not compositionValidator.getSlotKey() %}
                if ($shouldTrack) {
                    {% if compositionProperty.branchClaimsAllKeys() %}
                        $this->_compositionEvaluations[$validatorIndex][$validatorComponentIndex] = true;
                    {% endif %}
                    {% if not compositionProperty.branchClaimsAllKeys() and compositionProperty.getNestedSchema() %}
                        $this->_compositionEvaluations[$validatorIndex][$validatorComponentIndex] = is_object($value) ? $value : null;
                    {% endif %}
                    {% if not compositionProperty.branchClaimsAllKeys() and not compositionProperty.getNestedSchema() %}
                        $this->_compositionEvaluations[$validatorIndex][$validatorComponentIndex] = $this->collectEvaluatedProperties(
                            $modelData,
                            {{ compositionProperty.getBranchDeclaredPropertyNamesPhpLiteral() }},
                            {{ compositionProperty.getBranchPatternPropertyPatternsPhpLiteral() }},
                        );
                    {% endif %}
                }
            {% endif %}
            {% if compositionProperty.tracksEvaluatedItems() and not compositionValidator.isNotComposition() %}
                $evaluatedItemIndicesOfSucceededBranches = array_replace_recursive(
                    $evaluatedItemIndicesOfSucceededBranches,
                    $this->_evaluatedItemIndices,
                );
            {% endif %}
        } catch (\Exception $e) {
            {% if viewHelper.isMutableBaseValidator(generatorConfiguration, isBaseValidator) and not generatorConfiguration.collectErrors() %}
                if (isset($validatorIndex)) {
                    $this->_propertyValidationState[$validatorIndex][$validatorComponentIndex] = false;
                }
            {% endif %}

            {% if compositionValidator.hasEvaluationTrackingEnabled() and not compositionValidator.getSlotKey() %}
                $this->_compositionEvaluations[$validatorIndex][$validatorComponentIndex] = null;
            {% endif %}

            {% if not generatorConfiguration.collectErrors()
                  and not viewHelper.isMutableBaseValidator(generatorConfiguration, isBaseValidator)
            %}
                {#
                    Record the failing branch's own exception (rendered as "Failed" with its
                    message) so the composition exception surfaces the underlying reason in
                    direct-exception mode. Control-flow exceptions used purely for counting are not
                    ValidationExceptions and contribute no message.
                #}
                $branchErrorRegistry = new \PHPModelGenerator\Exception\ErrorRegistryException();
                if ($e instanceof \PHPModelGenerator\Exception\ValidationException) {
                    $branchErrorRegistry->addError($e);
                }
                $compositionErrorCollection[] = $branchErrorRegistry;
            {% endif %}

            $succeededCompositionElements--;
        {% if compositionProperty.tracksEvaluatedItems() %}
        } finally {
            $this->_evaluatedItemIndices = $evaluatedItemIndicesBeforeComposition;
        }
        {% else %}
        }
        {% endif %}

        {% if compositionValidator.isNotComposition() and compositionValidator.hasEvaluationTrackingEnabled() and not compositionValidator.getSlotKey() %}
            // Restore composition evaluations so any annotations written by the not-branch body
            // (including by nested UnevaluatedPropertiesValidators) cannot leak to the parent schema.
            $this->_compositionEvaluations = $preNotBranchEvaluations;
            $this->_compositionEvaluations[$validatorIndex][$validatorComponentIndex] = null;
        {% endif %}

        $value = $originalModelData;
        $validatorComponentIndex++;
    {% endforeach %}

    {#
        Only a satisfied composition may adopt a branch's (possibly decorator-transformed)
        proposed value. If no branch succeeded, $proposedValue never advanced past its initial
        null (each branch only reaches "$proposedValue = $proposedValue ?? $value;" once it has
        already passed its own composition-error check), so unconditionally assigning it to $value
        would replace the real input with null — corrupting both this validator's own reported
        value and, since array/object items are validated by reference, the original data itself.
    #}
    $compositionSatisfied = {{ composedValueValidation }};

    {% if compositionValidator.tracksEvaluatedItems() and not compositionValidator.isNotComposition() %}
        $this->_evaluatedItemIndices = array_replace_recursive(
            $this->_evaluatedItemIndices,
            $evaluatedItemIndicesOfSucceededBranches,
        );
    {% endif %}

    {% if publishesFilteredValues %}
        {#
            Hand the filtered values of the passing branches to the schema. $modifiedValues only contains
            values of passing components, so for a oneOf these are the values of the single matching branch.
        #}
        $publishedValues = $compositionSatisfied ? array_intersect_key($modifiedValues, {{ filteredKeyLookup }}) : null;
    {% endif %}

    {% if mergedProperty %}
        if ($compositionSatisfied && is_object($proposedValue)) {
            if ($modifiedValues) {
                $value = array_merge($value, $modifiedValues);
            }

            {{ viewHelper.resolvePropertyDecorator(mergedProperty, false, 2) }}
        } elseif ($compositionSatisfied) {
            $value = $proposedValue;
        } else {
            $value = $originalModelData;
        }
    {% else %}
        if ($compositionSatisfied) {
            {% if hasModifiedValuesMethod %}
                {#
                    The map is only populated for compositions of the schema itself, whose value is always
                    the model data array - a composition on a named property (which may hold a scalar) never
                    writes branch defaults to the model.
                #}
                foreach ({{ allBranchDefaultAttributeMap }} as $branchDefaultKey => $branchDefaultAttr) {
                    if (!array_key_exists($branchDefaultKey, $originalModelData)) {
                        $this->$branchDefaultAttr = array_key_exists($branchDefaultKey, $modifiedValues)
                            ? $modifiedValues[$branchDefaultKey]
                            : null;
                    }
                }
            {% endif %}
            {# Array-side compositions (slotKey set) never produce a nested-instance
               $proposedValue; writing $proposedValue back would replace the validated array
               with null on whole-composition failure, suppressing a subsequent
               unevaluatedItems check in collectErrors mode. #}
            {% if not compositionValidator.getSlotKey() %}
                $value = $proposedValue;
            {% endif %}
        } else {
            $value = $originalModelData;
        }
    {% endif %}

    {% if compositionValidator.hasItemFilteringBranches() %}
        {#
            Every successful branch which filters items contributes the items it transformed. Adopting the proposed
            value alone was rejected: it is the value of the first successful branch, the transformed items of any other
            branch (a later allOf branch, a branch of an anyOf behind a plain one) would be discarded, and a composition
            which tracks evaluated indices doesn't adopt a proposed value at all. Only the items which differ from the
            items as provided are taken over, a branch never changes the other items.
        #}
        if ($compositionSatisfied && is_array($originalModelData) && is_array($value)) {
            foreach ($branchItemValues as $branchItemValue) {
                if (!is_array($branchItemValue)) {
                    continue;
                }

                foreach ($branchItemValue as $itemIndex => $itemValue) {
                    if (!array_key_exists($itemIndex, $originalModelData) || $itemValue !== $originalModelData[$itemIndex]) {
                        $value[$itemIndex] = $itemValue;
                    }
                }
            }
        }
    {% endif %}

    {% if generatorConfiguration.collectErrors() %}
        $this->_errorRegistry = $originalErrorRegistry;
    {% endif %}

    $result = !$compositionSatisfied;

    {#
        A rejected composition doesn't restore the validation state recorded above: the update operation (setter,
        populate, additional property accessors) restores the complete model state of a rejected update. The
        evaluations of the branches which succeeded are kept also if the composition fails (the evaluations of a
        failed branch are already discarded): like the evaluated items above, the unevaluated keys validated next to
        a failed composition with collected errors see what its passing branches evaluated. A not never contributes:
        its branch is restored after the evaluation.
    #}
    {% if compositionValidator.hasEvaluationTrackingEnabled() and compositionValidator.getSlotKey() %}
        {% if compositionValidator.isNotComposition() %}
            $this->_compositionAnnotated[$slotKey] = [];
        {% else %}
            $this->_compositionAnnotated[$slotKey] = $compositionEvaluatedIndices;
        {% endif %}
    {% endif %}

    return $result;
})($value)
