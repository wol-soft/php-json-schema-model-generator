{% if schema.getBaseValidators() %}
    $this->_executeBaseValidators($modelData);
{% endif %}

{% if dependencyValidation %}
    $validatedProperties = [];
{% endif %}

{% foreach schema.getProperties() as property %}
    {% if not property.isInternal() %}
        if (
            array_key_exists('{{ property.getName() }}', $modelData) &&
            $modelData['{{ property.getName() }}'] !== $this->{{ property.getAttribute(true) }}
        ) {
            {{ schemaHookResolver.resolveSetterBeforeValidationHook(property, true) }}

            $updatedProperties['{{ property.getAttribute(true) }}'] = true;
            {% if dependencyValidation %}
                $validatedProperties[] = '{{ property.getName() }}';
            {% endif %}
            $this->_process{{ viewHelper.ucfirst(property.getAttribute()) }}($modelData);
        }
    {% endif %}
{% endforeach %}

{#
    A schema dependency of a property which isn't updated validates the whole object, the update may violate it. The
    dependencies of the updated properties are validated with the properties.
#}
{% if dependencyValidation %}
    $this->_executeDependencyValidators(array_merge($this->_rawModelDataInput, $modelData), $validatedProperties);
{% endif %}

{% if schema.hasMethod('_prepareBranchFilteredValues') %}
    // Only the properties which were processed count as processed: a value which equals the current attribute is
    // skipped, such a property is validated again if the active branch switched.
    $preparedBranchFilteredValues = $this->_prepareBranchFilteredValues(
        array_keys($updatedProperties),
        array_merge($this->_rawModelDataInput, $modelData),
    );
{% endif %}

{% if generatorConfiguration.collectErrors() %}
    if (count($this->_errorRegistry->getErrors())) {
        throw $this->_errorRegistry;
    }
{% endif %}
