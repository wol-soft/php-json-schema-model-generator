/**
 *{% if hasObjectProperties %} @throws RegularPropertyAsAdditionalPropertyException{% endif %}
 *{% if schema.getBaseValidators() or schema.getPostCompositionValidators() or typedProperties %} @throws {% if generatorConfiguration.collectErrors() %}{{ viewHelper.getSimpleClassName(generatorConfiguration.getErrorRegistryClass()) }}{% else %}ValidationException{% endif %}{% endif %}
 */
private function _setAdditionalProperty(
    string $key,
    {% if validationProperty %}{{ viewHelper.getType(validationProperty) }}{% else %}mixed{% endif %} $value
): void {
    {% if hasObjectProperties %}
        if (in_array($key, {{ objectProperties }})) {
            throw new RegularPropertyAsAdditionalPropertyException($value, $key, {{ objectPropertyPointers }}[$key] ?? '', self::class);
        }
    {% endif %}

    if (isset($this->_additionalProperties[$key]) && $this->_additionalProperties[$key] === $value) {
        return;
    }

    {% if generatorConfiguration.collectErrors() %}
        $this->_errorRegistry = new {{ viewHelper.getSimpleClassName(generatorConfiguration.getErrorRegistryClass()) }}();
    {% endif %}

    {% if schema.hasMethod('_prepareBranchFilteredValues') %}
        // the compositions stage the filtered values of their active branches for this update
        $this->_stagedBranchFilteredValues = [];
    {% endif %}

    {#
        The base validators store the value (as additional or pattern property) and evaluate the compositions before
        the update is accepted - restore the model state if a later validator rejects the update. Hook code is only
        resolved for a validation property, which exists only with an AdditionalPropertiesValidator (a base
        validator), so the hook code is wrapped as well. The post-composition validators record the evaluated and
        the unevaluated keys. The processing of a typed property assigns its attribute, which is restored as well if a
        later validator rejects the update.
    #}
    {% if schema.getBaseValidators() or schema.getPostCompositionValidators() or typedProperties %}
        {{ viewHelper.indent(modelStateRollback.wrap(schema, renderUpdate()), 1) }}
    {% else %}
        {{ viewHelper.indent(renderUpdate(), 1) }}
    {% endif %}

    $this->_rawModelDataInput[$key] = $value;

    {% if schema.hasMethod('_prepareBranchFilteredValues') %}
        $this->_applyBranchFilteredValues($preparedBranchFilteredValues);
    {% endif %}

    {% if validationProperty %}{{ schemaHookResolver.resolveSetterAfterValidationHook(validationProperty) }}{% endif %}

    {% foreach typedProperties as typedProperty %}
        {% if schemaHookResolver.resolveSetterAfterValidationHook(typedProperty) %}
            if ($key === {{ viewHelper.varExportArray(typedProperty.getName()) }}) {
                {{ viewHelper.indent(schemaHookResolver.resolveSetterAfterValidationHook(typedProperty), 2) }}
            }
        {% endif %}
    {% endforeach %}
}
