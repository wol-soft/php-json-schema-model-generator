/**
 *{% if minPropertyValidator or compositionValidatorKeys or dependencyValidators or schema.getPostCompositionValidators() %} @throws {% if generatorConfiguration.collectErrors() %}{{ viewHelper.getSimpleClassName(generatorConfiguration.getErrorRegistryClass()) }}{% else %}ValidationException{% endif %}{% endif %}
 */
private function _removeAdditionalProperty(string $key): bool
{
    $inAdditionalProperties = array_key_exists($key, $this->_additionalProperties);

    $inPatternProperties = false;
    if (isset($this->_patternProperties)) {
        foreach ($this->_patternProperties as $patternEntries) {
            if (isset($patternEntries[$key])) {
                $inPatternProperties = true;
                break;
            }
        }
    }

    if (!$inAdditionalProperties && !$inPatternProperties) {
        return false;
    }

    {% if generatorConfiguration.collectErrors() %}
        {% if minPropertyValidator or compositionValidatorKeys or dependencyValidators or schema.getPostCompositionValidators() %}
            $this->_errorRegistry = new {{ viewHelper.getSimpleClassName(generatorConfiguration.getErrorRegistryClass()) }}();
        {% endif %}
    {% endif %}

    {% if compositionValidatorKeys and schema.hasMethod('_prepareBranchFilteredValues') %}
        // the compositions stage the filtered values of their active branches for this update
        $this->_stagedBranchFilteredValues = [];
    {% endif %}

    {% if minPropertyValidator %}
        if ({{ minPropertyValidator.getCheck() }}) {
            {{ viewHelper.validationError(minPropertyValidator) }}
        }

        {#
            Collected errors of the count are thrown together with the errors of the validation of the remaining data
            (like the constructor collects them), which throws the registry itself.
        #}
        {% if generatorConfiguration.collectErrors() %}
            {% if not compositionValidatorKeys and not dependencyValidators and not schema.getPostCompositionValidators() %}
                if (count($this->_errorRegistry->getErrors())) {
                    throw $this->_errorRegistry;
                }
            {% endif %}
        {% endif %}
    {% endif %}

    {#
        The compositions, the dependencies of the declared properties and the post-composition validators are validated
        against the remaining model data after the property is removed - restore the model state if they reject the
        removal.
    #}
    {% if compositionValidatorKeys or dependencyValidators or schema.getPostCompositionValidators() %}
        {{ viewHelper.indent(modelStateRollback.wrap(schema, renderUpdate()), 1) }}
    {% else %}
        {{ viewHelper.indent(renderUpdate(), 1) }}
    {% endif %}

    {% if compositionValidatorKeys and schema.hasMethod('_prepareBranchFilteredValues') %}
        $this->_applyBranchFilteredValues($preparedBranchFilteredValues);
    {% endif %}

    return true;
}
