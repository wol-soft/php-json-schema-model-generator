/**
 *{% if minPropertyValidator or compositionValidatorKeys or dependencyValidators %} @throws {% if generatorConfiguration.collectErrors() %}{{ viewHelper.getSimpleClassName(generatorConfiguration.getErrorRegistryClass()) }}{% else %}ValidationException{% endif %}{% endif %}
 */
private function _removeAdditionalProperty(string $key): bool
{
    $inAdditionalProperties = array_key_exists($key, $this->_additionalProperties);

    $inPatternProperties = false;
    if (isset($this->_patternProperties)) {
        foreach ($this->_patternProperties as $patternHash => $_) {
            if (isset($this->_patternProperties[$patternHash][$key])) {
                $inPatternProperties = true;
                break;
            }
        }
    }

    if (!$inAdditionalProperties && !$inPatternProperties) {
        return false;
    }

    {% if generatorConfiguration.collectErrors() %}
        {% if minPropertyValidator or compositionValidatorKeys or dependencyValidators %}
            $this->_errorRegistry = new {{ viewHelper.getSimpleClassName(generatorConfiguration.getErrorRegistryClass()) }}();
        {% endif %}
    {% endif %}

    {% if compositionValidatorKeys and schema.hasMethod('_prepareBranchFilteredValues') %}
        // the compositions stage the filtered values of their active branches for this update
        $this->_stagedBranchFilteredValues = [];
    {% endif %}

    {% if minPropertyValidator %}
        if ({{ minPropertyValidator.getCheck() }}) {
            {{ viewHelper.validationError(minPropertyValidator) }}
        }

        {% if generatorConfiguration.collectErrors() %}
            if (count($this->_errorRegistry->getErrors())) {
                throw $this->_errorRegistry;
            }
        {% endif %}
    {% endif %}

    {#
        The compositions and the dependencies of the declared properties are validated against the remaining model
        data after the property is removed - restore the model state if they reject the removal.
    #}
    {% if compositionValidatorKeys or dependencyValidators %}
        {{ viewHelper.indent(modelStateRollback.wrap(schema, renderUpdate()), 1) }}
    {% else %}
        {{ viewHelper.indent(renderUpdate(), 1) }}
    {% endif %}

    {% if compositionValidatorKeys and schema.hasMethod('_prepareBranchFilteredValues') %}
        $this->_applyBranchFilteredValues($preparedBranchFilteredValues);
    {% endif %}

    return true;
}
