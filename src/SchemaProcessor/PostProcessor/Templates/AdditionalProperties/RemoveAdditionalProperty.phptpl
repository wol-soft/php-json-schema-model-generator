/**
 *{% if minPropertyValidator or compositionValidatorKeys %} @throws {% if generatorConfiguration.collectErrors() %}{{ viewHelper.getSimpleClassName(generatorConfiguration.getErrorRegistryClass()) }}{% else %}ValidationException{% endif %}{% endif %}
 */
private function _removeAdditionalProperty(string $key): bool
{
    $inAdditionalProperties = array_key_exists($key, $this->_additionalProperties);

    $inPatternProperties = false;
    if (isset($this->_patternProperties)) {
        foreach ($this->_patternProperties as $patternHash => $_) {
            if (isset($this->_patternProperties[$patternHash][$key])) {
                $inPatternProperties = true;
                break;
            }
        }
    }

    if (!$inAdditionalProperties && !$inPatternProperties) {
        return false;
    }

    {% if generatorConfiguration.collectErrors() %}
        {% if minPropertyValidator or compositionValidatorKeys %}
            $this->_errorRegistry = new {{ viewHelper.getSimpleClassName(generatorConfiguration.getErrorRegistryClass()) }}();
        {% endif %}
    {% endif %}

    {% if minPropertyValidator %}
        if ({{ minPropertyValidator.getCheck() }}) {
            {{ viewHelper.validationError(minPropertyValidator) }}
        }

        {% if generatorConfiguration.collectErrors() %}
            if (count($this->_errorRegistry->getErrors())) {
                throw $this->_errorRegistry;
            }
        {% endif %}
    {% endif %}

    {#
        A composition with a branch depending on keys it doesn't declare (e.g. minProperties) is validated against
        the remaining model data after the property is removed - restore the model state if it rejects the removal.
    #}
    {% if compositionValidatorKeys %}
        {{ viewHelper.indent(viewHelper.wrapInModelStateRollback(schema, renderUpdate()), 1) }}
    {% else %}
        {{ viewHelper.indent(renderUpdate(), 1) }}
    {% endif %}

    return true;
}
