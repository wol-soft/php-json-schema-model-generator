if ($inPatternProperties) {
    foreach (array_keys($this->_patternProperties) as $patternHash) {
        unset($this->_patternProperties[$patternHash][$key]);
    }
}

unset($this->_rawModelDataInput[$key]);

if ($inAdditionalProperties) {
    unset($this->_additionalProperties[$key]);
}

{#
    The typed attribute of the removed key holds the state of an absent key: its default (null without a default). The
    reset happens before the compositions are validated: a composition may apply the default of a branch to the
    attribute, which a later reset would overwrite.
#}
{% foreach typedProperties as typedProperty %}
    if ($key === {{ viewHelper.varExportArray(typedProperty.getName()) }}) {
        $this->{{ typedProperty.getAttribute(true) }} = {% if viewHelper.isNull(typedProperty.getDefaultValue()) %}null{% else %}{{ typedProperty.getDefaultValue() }}{% endif %};
    }
{% endforeach %}

{#
    Validate the remaining data in the order of the constructor: the compositions are base validators, the
    dependencies are validators of the declared properties.
#}
{% if compositionValidatorKeys %}
    // the compositions merge the remaining model data, no property is updated
    $updatedModelData = [];
    {% foreach compositionValidatorKeys as compositionValidatorKey %}
        {#
            The cached result of a branch is kept as long as none of its properties is updated, but the removed key
            may be one of them - and a removed key can't be passed as updated model data. Discard the cached results.
        #}
        $this->_propertyValidationState[{{ compositionValidatorKey }}] = [];
        $this->_validateComposition_{{ compositionValidatorKey }}($updatedModelData);
    {% endforeach %}
{% endif %}

{#
    The typed attribute of the removed key is validated like the constructor validates an absent key - a required
    property rejects the removal. Resetting the attribute without validating it was rejected: the removal would bypass
    the required keyword. Processing the attribute without the reset above was rejected as well: for an absent key the
    processing keeps the current value of the attribute, which is the removed one.
#}
{% foreach typedProperties as typedProperty %}
    if ($key === {{ viewHelper.varExportArray(typedProperty.getName()) }}) {
        $this->_process{{ viewHelper.ucfirst(typedProperty.getAttribute()) }}($this->_rawModelDataInput);
    }
{% endforeach %}

{% if dependencyValidators %}
    $this->_executeDependencyValidators($this->_rawModelDataInput);
{% endif %}

{#
    The removed key may have been the only one a composition branch required: the keys the active branches don't
    evaluate any longer are validated against the remaining data. A copy, the validators take the data by reference.
#}
{% if schema.getPostCompositionValidators() %}
    $remainingModelData = $this->_rawModelDataInput;
    $this->_executePostCompositionValidators($remainingModelData);
{% endif %}

{#
    The removed key may switch the active branch of a composition: the properties depending on the active branch are
    validated again before the removal is accepted (no property of the model is processed by the update).
#}
{% if compositionValidatorKeys and schema.hasMethod('_prepareBranchFilteredValues') %}
    $preparedBranchFilteredValues = $this->_prepareBranchFilteredValues([], $this->_rawModelDataInput);
{% endif %}

{% if compositionValidatorKeys or dependencyValidators or typedProperties or schema.getPostCompositionValidators() %}
    {% if generatorConfiguration.collectErrors() %}
        if (count($this->_errorRegistry->getErrors())) {
            throw $this->_errorRegistry;
        }
    {% endif %}
{% endif %}
