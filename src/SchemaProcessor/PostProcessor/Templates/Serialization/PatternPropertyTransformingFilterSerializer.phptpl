/**
 * serialize all pattern properties for the pattern key {{ key }}
 */
protected function _serialize{{ viewHelper.ucfirst(key) }}(): array
{
    $serialized = [];
    foreach ($this->_patternProperties['{{ key }}'] as $propertyKey => $value) {
        {% if entrySerializer.guard %}
            $serialized[$propertyKey] = {{ entrySerializer.guard }} ? {{ entrySerializer.call }} : $value;
        {% else %}
            $serialized[$propertyKey] = {{ entrySerializer.call }};
        {% endif %}
    }

    return $serialized;
}
