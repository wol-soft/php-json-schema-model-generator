protected function _serializeUnevaluatedProperties(int $depth, array $except, bool $emptyObjectsAsStdClass): array
{
    $serializedValues = [];
    foreach ($this->_unevaluatedProperties as $key => $value) {
        {% if entrySerializer.guard %}
            $serializedValues[$key] = {{ entrySerializer.guard }} ? {{ entrySerializer.call }} : $value;
        {% else %}
            $serializedValues[$key] = {{ entrySerializer.call }};
        {% endif %}
    }

    return (array) $this->_getSerializedValue($serializedValues, $depth, $except, $emptyObjectsAsStdClass);
}
