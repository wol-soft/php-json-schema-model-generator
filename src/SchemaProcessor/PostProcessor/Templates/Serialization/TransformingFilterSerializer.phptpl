/**
 * serialize the property {{ property.getAttribute() }}
 */
protected function _serialize{{ viewHelper.ucfirst(property.getAttribute()) }}()
{
    {% if guardedSerializers %}
        {{ viewHelper.indent(guardedSerializers, 1) }}
    {% else %}
        return \{{ serializerClass }}::{{ serializerMethod }}($this->{{ property.getAttribute(true) }}, {{ serializerOptions }});
    {% endif %}
}
