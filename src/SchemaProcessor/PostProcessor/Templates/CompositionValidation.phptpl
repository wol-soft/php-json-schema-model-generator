/**
 * Validate updated properties which are part of a composition validation
 *
 * @param array $modifiedModelData An array containing all updated data as key-value pairs
 *
 *{% if not generatorConfiguration.collectErrors() %} @throws ValidationException{% endif %}
 */
private function _validateComposition_{{ index }}(array &$modifiedModelData): void
{
    $validatorIndex = {{ index }};
    $value = $modelData = array_merge($this->_rawModelDataInput, $modifiedModelData);

    {{ viewHelper.indent(validator.getValidatorSetUp(), 1) }}
    if {{ viewHelper.formatCondition(validator.getCheck(), 1) }} {
        {{ viewHelper.validationError(validator) }}
    }

    {% if branchFilteredKeys %}
        // Stage the values of the active branch. They are adopted by _commitBranchFilteredValues() when the update
        // succeeded. null: no active branch of this composition hands over a value for the property. A property
        // owned by a component which kept the result of its previous evaluation is not staged: the component did
        // not hand over a value again, the schema keeps the value which is already committed.
        foreach ({{ branchFilteredKeyComponents }} as $filteredKey => $componentIndices) {
            if (array_key_exists($filteredKey, $publishedValues ?? [])) {
                $this->_stagedBranchFilteredValues[$filteredKey] = [$publishedValues[$filteredKey]];
            } elseif (!array_diff($componentIndices, $evaluatedComponents)) {
                $this->_stagedBranchFilteredValues[$filteredKey] = null;
            }
        }

    {% endif %}
    foreach (array_keys($modifiedModelData) as $property) {
        $modifiedModelData[$property] = $modelData[$property];
    }
}
