{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "$defs": {
    "TaggedArray": {
      "type": "array",
      "contains": {
        "type": "string"
      },
      "minContains": 2,
      "maxContains": 4
    }
  },
  "type": "object",
  "properties": {
    "tags": {
      "allOf": [
        {
          "$ref": "#/$defs/TaggedArray"
        },
        {
          "type": "array"
        }
      ]
    }
  }
}
