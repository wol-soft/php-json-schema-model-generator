{
  "type": "object",
  "definitions": {
    "allOfValue": {
      "allOf": [
        {
          "type": "integer"
        },
        {
          "minimum": 5
        }
      ]
    },
    "anyOfValue": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "string"
        }
      ]
    },
    "oneOfValue": {
      "oneOf": [
        {
          "type": "integer"
        },
        {
          "type": "string"
        }
      ]
    },
    "conditionalValue": {
      "if": {
        "type": "integer"
      },
      "then": {
        "minimum": 5
      },
      "else": {
        "type": "string"
      }
    },
    "notTrueValue": {
      "not": true
    },
    "falseBranch": {
      "anyOf": [
        false,
        {
          "type": "integer"
        }
      ]
    },
    "listBranch": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        {
          "type": "string"
        }
      ]
    },
    "pairBranch": {
      "anyOf": [
        {
          "type": "array",
          "items": [
            {
              "type": "string"
            }
          ]
        },
        {
          "type": "integer"
        }
      ]
    },
    "filteredAnyOf": {
      "type": "string",
      "filter": "dateTime",
      "anyOf": [
        {
          "minLength": 20
        },
        {
          "pattern": "^2"
        }
      ]
    }
  },
  "properties": {
    "allOfValueA": {
