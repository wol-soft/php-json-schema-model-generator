      "type": "string",
      "filter": "trim"
    },
    "text": {
      "type": "string"
    },
    "number": {
      "type": "integer"
    }
  },
  "properties": {
    "kind": {
      "type": "string"
    },
    "first": {
      "$ref": "#/definitions/trimmed"
    },
    "date": {
      "$ref": "#/definitions/text"
    },
    "other": {
      "$ref": "#/definitions/text"
    },
    "count": {
      "$ref": "#/definitions/number"
    }
  },
  "if": {
    "properties": {
      "kind": {
        "const": "a"
      }
    },
